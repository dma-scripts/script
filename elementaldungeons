local function GetHrp()
    local char = LocalPlayer.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("PrimaryPart"))
end

local function GetHum()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function GetClosestMob()
    local hrp = GetHrp()
    if not hrp then return nil, nil, false end

    local closestMob, closestHrp = nil, nil
    local shortestDistance = math.huge
    local isBossFound = false

    -- Universal Workspace Model Scan
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) then
            local mHum = obj:FindFirstChildOfClass("Humanoid")
            local mHrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
            
            if mHum and mHrp and mHum.Health > 0 and mHrp:IsA("BasePart") then
                local n = obj.Name:lower()
                local isBoss = n:find("boss") or n:find("titan") or n:find("king") or n:find("lord") or n:find("warlord") or n:find("dragon") or n:find("reaper") or (mHum.MaxHealth > 5000)
                local dist = (hrp.Position - mHrp.Position).Magnitude

                if isBoss and not isBossFound then
                    isBossFound = true
                    shortestDistance = dist
                    closestMob = obj
                    closestHrp = mHrp
                elseif (isBoss and isBossFound) or (not isBoss and not isBossFound) then
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestMob = obj
                        closestHrp = mHrp
                    end
                end
            end
        end
    end

    return closestMob, closestHrp, isBossFound
end

