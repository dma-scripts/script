FOVCircle.NumSides = 40
FOVCircle.Radius = Config.Aimbot.FOV
FOVCircle.Filled = false
FOVCircle.Transparency = 0.6

local function IsVisible(part, character)
    if not part or not character then return false end
    local origin = Camera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, character, Camera}
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, params)
    return result == nil
end

local function GetTargetModel(modelName)
    local live = Workspace:FindFirstChild("Live")
    if live then
        return live:FindFirstChild(modelName)
    end
    return nil
end

local function IsTeammate(model)
    if not model then return false end
    local player = Players:GetPlayerFromCharacter(model)
    if player and LocalPlayer then
        if player.Team ~= nil and LocalPlayer.Team ~= nil then
            return player.Team == LocalPlayer.Team
        end
    end
    -- Fallback: Check Team value inside character Stats folder or attributes
    local stats = model:FindFirstChild("Stats")
    local myStats = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Stats")
    if stats and myStats then
        local teamVal = stats:FindFirstChild("Team") or stats:FindFirstChild("TeamName")
        local myTeamVal = myStats:FindFirstChild("Team") or myStats:FindFirstChild("TeamName")
        if teamVal and myTeamVal and teamVal.Value == myTeamVal.Value then
            return true
        end
    end
    return false
end

local function GetAimbotTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local closest, minDist = nil, Config.Aimbot.FOV
    local live = Workspace:FindFirstChild("Live")

    if live then
        for _, char in ipairs(live:GetChildren()) do
            if char:IsA("Model") and char.Name ~= LocalPlayer.Name then
                if not (Config.Aimbot.TeamCheck and IsTeammate(char)) then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local targetPart = char:FindFirstChild(Config.Aimbot.TargetPart) or char:FindFirstChild("Head")
                    if hum and targetPart and hum.Health > 0 then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if dist < minDist then
                                if not Config.Aimbot.WallCheck or IsVisible(targetPart, char) then
                                    minDist = dist
                                    closest = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

