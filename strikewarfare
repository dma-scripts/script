        Tween(knob, {Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.18, Enum.EasingStyle.Back):Play()
        callback(state)
        Notify(text, state and "Enabled" or "Disabled", 2, state and Theme.Good or Theme.Bad)
    end)
