                local completedHeaderFound = false
                local retryBtnObject = nil

                -- Strict scan: Only trigger when "Dungeon Completed!" screen is visible
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local txt = tostring(desc.Text or "")
                        if txt:find("Dungeon Completed") or txt:find("Rewards") then
                            completedHeaderFound = true
                        end
                        if txt:find("Retry") then
                            local btn = (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc or desc:FindFirstAncestorOfClass("TextButton") or desc:FindFirstAncestorOfClass("ImageButton") or desc.Parent
                            if btn and btn.Visible then
                                retryBtnObject = btn
                            end
                        end
                    end
                end

                -- Trigger 5-Second Cooldown & Click sequence ONLY on Dungeon Completed Screen
                if completedHeaderFound and retryBtnObject then
                    isCountingDown = true
                    Frame.Visible = true

                    for i = 5, 1, -1 do
                        Label.Text = "Replaying in " .. i .. "s..."
                        task.wait(1)
                    end

                    Label.Text = "Retrying Dungeon..."

                    -- Execute Click Sequence
                    pcall(function()
                        if getconnections then
                            for _, c in ipairs(getconnections(retryBtnObject.MouseButton1Click)) do c:Fire() end
                            for _, c in ipairs(getconnections(retryBtnObject.MouseButton1Down)) do c:Fire() end
                            for _, c in ipairs(getconnections(retryBtnObject.Activated)) do c:Fire() end
                        end

                        if retryBtnObject.AbsolutePosition and retryBtnObject.AbsoluteSize then
                            local center = retryBtnObject.AbsolutePosition + (retryBtnObject.AbsoluteSize / 2)
                            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
                            task.wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
                        end

                        -- Invoke Retry Remote Events
                        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") or game:GetService("ReplicatedStorage")
                        for _, r in ipairs(remotes:GetDescendants()) do
                            if r:IsA("RemoteEvent") and (r.Name:lower():find("retry") or r.Name:lower():find("requeue") or r.Name:lower():find("replay")) then
                                r:FireServer()
                            end
                        end
                    end)

                    task.wait(1)
                    Frame.Visible = false
                    isCountingDown = false
                end
            end)
        end
    end
end)


